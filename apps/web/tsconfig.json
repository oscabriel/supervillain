{
	"extends": "../../packages/config/tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"strictNullChecks": true,
		// TanStack Start's route files and generated route tree use the
		// extensionless relative imports Vite resolves; NodeNext would reject
		// them. `Preserve` + `Bundler` keeps declaration emit (the composite
		// contract) while matching the framework's resolution. The emitted js
		// under dist/ is a type-level artifact — the runtime artifact is
		// vite's `.output/`.
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["bun", "node"],
		// ADR-0020's accepted concession, verified by the #43 spike: without
		// this, `@tanstack/router-core`'s published d.ts fails on its own —
		// `MakeRouteMatch.__beforeLoadContext` (TS2339), an upstream defect,
		// plus a `node:http2` types requirement. Our own sources still check
		// strict + noUncheckedIndexedAccess; only library d.ts checking is
		// skipped. Re-test on every @tanstack pin bump and drop when fixed.
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
