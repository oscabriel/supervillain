[Unit]
Description=supervillain SQLite continuous replication
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sv-litestream
Group=sv-litestream
SupplementaryGroups=sv-gateway sv-web
EnvironmentFile=/etc/supervillain/litestream.env
ExecStart=/usr/local/bin/litestream replicate -config /etc/supervillain/litestream.yml
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=45s
# Setgid store directories choose the gateway/web group for new WAL sidecars.
UMask=0007

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/supervillain
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
