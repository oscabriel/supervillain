[Unit]
Description=supervillain nightly belt-and-braces backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/supervillain/restic.env
Environment=RESTIC_CACHE_DIR=/run/sv-restic/cache
ExecStart=/usr/local/libexec/supervillain/restic-backup
RuntimeDirectory=sv-restic
RuntimeDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/supervillain /var/lib/caddy
ReadWritePaths=/run/sv-restic
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
