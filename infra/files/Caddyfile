# The apex answers HTTP(S); sv-gateway independently owns TCP 22. The explicit
# HTTP blocks preserve #30/#40's canonical temporary redirect instead of
# relying on Caddy's automatic permanent HTTP-to-HTTPS redirect.

(supervillain_access_log) {
	log {
		output file /var/log/caddy/supervillain-access.log {
			mode 0640
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			# Keep the request line for operations, but capability paths are
			# credentials: the concrete path and query never leave this edge.
			request>uri regexp ^/a/.*$ /a/REDACTED
			# A Referer may itself contain a capability URL. It has no safe log form.
			request>headers>Referer delete
			wrap json
		}
	}
}

http://supervillain.app {
	import supervillain_access_log
	redir https://supervillain.app{uri} 302
}

http://www.supervillain.app {
	import supervillain_access_log
	redir https://supervillain.app{uri} 302
}

https://www.supervillain.app {
	import supervillain_access_log
	redir https://supervillain.app{uri} 308
}

supervillain.app {
	import supervillain_access_log

	# The Host pipe shares 443 with the web surface. Its listener accepts only
	# WebSocket upgrades and is loopback-only in terminated-upstream mode.
	@gateway_pipe {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	route {
		reverse_proxy @gateway_pipe 127.0.0.1:3001
		reverse_proxy 127.0.0.1:3000
	}
}
