[Unit]
Description=Validate or create the supervillain web token reconstruction key
Before=sv-web.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/supervillain/ensure-web-token-key
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/etc/supervillain
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
