# Copy to litestream.env (ignored by git), fill every value, chmod 0600.
# Use a write-only object-storage credential where the provider permits it.
LITESTREAM_REPLICA_URL=s3://REPLACE_BUCKET/supervillain
LITESTREAM_ENDPOINT=https://REPLACE_S3_ENDPOINT
LITESTREAM_REGION=REPLACE_REGION
LITESTREAM_FORCE_PATH_STYLE=true
LITESTREAM_ACCESS_KEY_ID=REPLACE_ME
LITESTREAM_SECRET_ACCESS_KEY=REPLACE_ME
LITESTREAM_HEARTBEAT_URL=https://hc-ping.com/REPLACE_ME
