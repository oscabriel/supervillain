#!/bin/sh
# Prove the pinned directory watcher discovers, replicates, and restores both
# store paths without production object-storage credentials.
set -eu

version=0.5.15
sha256=559d030679df92b4556fd9de6582378246358f98c1354760f9fd5e31198c60a1
temporary=$(mktemp -d "${TMPDIR:-/tmp}/sv-litestream-validation.XXXXXX")
pid=
cleanup() {
	if [ -n "$pid" ]; then
		kill "$pid" 2>/dev/null || true
		wait "$pid" 2>/dev/null || true
	fi
	rm -rf "$temporary"
}
trap cleanup EXIT HUP INT TERM

if command -v litestream >/dev/null 2>&1; then
	litestream=$(command -v litestream)
else
	deb=$temporary/litestream.deb
	curl --fail --silent --show-error --location \
		-o "$deb" \
		"https://github.com/benbjohnson/litestream/releases/download/v$version/litestream-$version-linux-x86_64.deb"
	printf '%s  %s\n' "$sha256" "$deb" | sha256sum --check --status
	mkdir -p "$temporary/deb" "$temporary/package"
	(
		cd "$temporary/deb"
		ar x "$deb"
		bsdtar -xf data.tar.* -C "$temporary/package"
	)
	litestream=$temporary/package/usr/bin/litestream
fi

state=$temporary/state
replica=$temporary/replica
mkdir -p "$state/gateway" "$state/web" "$state/litestream" "$replica"
cat >"$temporary/litestream.yml" <<EOF
sync-interval: 100ms
shutdown-sync-timeout: 10s
dbs:
  - dir: $state
    pattern: "*.db"
    recursive: true
    watch: true
    meta-dir: $state/litestream
    replica:
      url: file://$replica/sqlite
EOF

"$litestream" replicate -config "$temporary/litestream.yml" \
	>"$temporary/litestream.log" 2>&1 &
pid=$!
sleep 0.5
sqlite3 "$state/gateway/registry.db" \
	"PRAGMA journal_mode=WAL; CREATE TABLE rooms(name TEXT); INSERT INTO rooms VALUES('watched-room');" \
	>/dev/null
sqlite3 "$state/web/store.db" \
	"PRAGMA journal_mode=WAL; CREATE TABLE artifacts(name TEXT); INSERT INTO artifacts VALUES('watched-artifact');" \
	>/dev/null

attempt=0
while [ "$attempt" -lt 100 ]; do
	if grep -q 'gateway/registry.db' "$temporary/litestream.log" && \
		grep -q 'web/store.db' "$temporary/litestream.log"; then
		break
	fi
	if ! kill -0 "$pid" 2>/dev/null; then
		cat "$temporary/litestream.log" >&2
		exit 1
	fi
	attempt=$((attempt + 1))
	sleep 0.1
done
if [ "$attempt" -ge 100 ]; then
	cat "$temporary/litestream.log" >&2
	exit 1
fi
# Discovery and the first remote snapshot are separate asynchronous steps.
sleep 2
kill -TERM "$pid"
wait "$pid"
pid=

"$litestream" restore -integrity-check full \
	-o "$temporary/gateway.db" "file://$replica/sqlite/gateway/registry.db" >/dev/null
"$litestream" restore -integrity-check full \
	-o "$temporary/web.db" "file://$replica/sqlite/web/store.db" >/dev/null
[ "$(sqlite3 "$temporary/gateway.db" 'SELECT name FROM rooms;')" = watched-room ]
[ "$(sqlite3 "$temporary/web.db" 'SELECT name FROM artifacts;')" = watched-artifact ]
