#!/bin/sh
# Exercise the production filter shape against the pinned Caddy build. The
# structural unit test keeps this fixture and infra/files/Caddyfile in lockstep.
set -eu

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
	echo "validate-caddy-redaction: docker unavailable; skipped" >&2
	exit 0
fi

temporary=$(mktemp -d "${TMPDIR:-/tmp}/sv-caddy-redaction.XXXXXX")
container=
cleanup() {
	if [ -n "$container" ]; then
		docker rm -f "$container" >/dev/null 2>&1 || true
	fi
	rm -rf "$temporary"
}
trap cleanup EXIT HUP INT TERM
chmod 0755 "$temporary"
cat >"$temporary/Caddyfile" <<'EOF'
:18080 {
	log {
		output stdout
		format filter {
			request>uri regexp ^/a/.*$ /a/REDACTED
			request>headers>Referer delete
			wrap json
		}
	}
	respond "ok" 200
}
EOF

container=$(docker run --rm -d \
	-p 127.0.0.1:18080:18080 \
	-v "$temporary/Caddyfile:/etc/caddy/Caddyfile:ro" \
	caddy:2.11.4 caddy run --config /etc/caddy/Caddyfile --adapter caddyfile)

attempt=0
while ! curl --fail --silent --output /dev/null http://127.0.0.1:18080/docs; do
	attempt=$((attempt + 1))
	if [ "$attempt" -ge 50 ]; then
		docker logs "$container" >&2
		exit 1
	fi
	sleep 0.1
done
capability=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
referer_capability=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
curl --fail --silent --output /dev/null \
	-H "Referer: https://supervillain.app/a/$referer_capability" \
	"http://127.0.0.1:18080/a/$capability/og.png?token=$capability"
curl --fail --silent --output /dev/null http://127.0.0.1:18080/docs
sleep 0.2
docker logs "$container" >"$temporary/log" 2>&1

if grep -Fq "$capability" "$temporary/log" || \
	grep -Fq "$referer_capability" "$temporary/log"; then
	echo "Caddy emitted a capability canary" >&2
	exit 1
fi
grep -Fq '"uri":"/a/REDACTED"' "$temporary/log"
grep -Fq '"uri":"/docs"' "$temporary/log"
