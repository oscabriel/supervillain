#!/bin/sh
# Repository-only checks: no production credentials or live host required.
set -eu

root=$(CDPATH='' cd -- "$(dirname "$0")/../.." && pwd)
cd "$root"

for script in infra/scripts/ensure-web-token-key infra/scripts/restic-backup \
	infra/scripts/restore-drill infra/scripts/validate-backup-local \
	infra/scripts/validate-caddy-redaction infra/scripts/validate-litestream-local \
	infra/scripts/validate-live; do
	sh -n "$script"
done
python3 -m unittest infra.tests.test_deploy_artifacts
sh infra/scripts/validate-backup-local
sh infra/scripts/validate-litestream-local

if command -v caddy >/dev/null 2>&1; then
	caddy validate --config infra/files/Caddyfile --adapter caddyfile
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
	docker run --rm \
		-v "$root/infra/files/Caddyfile:/etc/caddy/Caddyfile:ro" \
		caddy:2.11.4 caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
	sh infra/scripts/validate-caddy-redaction
else
	echo "validate-local: caddy/docker unavailable; structural Caddy tests passed" >&2
fi

if command -v ansible-playbook >/dev/null 2>&1; then
	ANSIBLE_CONFIG="$root/infra/ansible.cfg" \
		ansible-playbook --syntax-check \
		-i infra/inventory/production.example.yml infra/playbooks/provision.yml
	ANSIBLE_CONFIG="$root/infra/ansible.cfg" \
		ansible-playbook --syntax-check \
		-i infra/inventory/production.example.yml infra/playbooks/deploy.yml \
		-e sv_deployable=web -e sv_release_sha=local \
		-e sv_artifact_path=/tmp/sv-web.tar.gz
else
	echo "validate-local: ansible-playbook unavailable; structural playbook tests passed" >&2
fi
