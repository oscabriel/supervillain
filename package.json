{
  "name": "supervillain",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "supervillain": "bun apps/supervillain/src/main.ts",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check": "oxlint --disable-nested-config && oxfmt --check",
    "fix": "oxlint --disable-nested-config --fix && oxfmt"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
