{
  "name": "supervillain",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/games/*"
  ],
  "scripts": {
    "postinstall": "bun packages/config/link-depcruise-typescript.ts",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "depcruise": "packages/config/node_modules/.bin/depcruise --config packages/config/dependency-cruiser.cjs apps packages --output-type err-long",
    "test:conformance": "bun test packages/core/test"
  },
  "devDependencies": {
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
