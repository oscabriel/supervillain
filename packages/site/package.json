{
	"name": "@supervillain/site",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"plan": "bunx --bun alchemy plan --env-file ../../.env --stage prod",
		"deploy": "bunx --bun alchemy deploy --env-file ../../.env --stage prod",
		"deploy:ci": "bunx --bun alchemy deploy --stage prod --yes",
		"destroy": "bunx --bun alchemy destroy --env-file ../../.env --stage prod"
	},
	"dependencies": {
		"@foldkit/markdown": "catalog:",
		"effect": "catalog:",
		"foldkit": "catalog:"
	},
	"devDependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@alchemy.run/frontend-frameworks": "catalog:",
		"@effect/platform-bun": "catalog:",
		"@foldkit/vite-plugin": "catalog:",
		"alchemy": "catalog:",
		"vite": "catalog:"
	}
}
