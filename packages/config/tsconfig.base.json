{
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"forceConsistentCasingInFileNames": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmitOnError": true,
		"noUncheckedIndexedAccess": true,
		"rootDir": "src",
		"outDir": "dist",
		"sourceMap": true,
		"strict": true,
		"target": "ES2024"
	}
}
